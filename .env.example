# =============================================================================
# STEMLAB — variables d'environnement
# Copier en `.env` a la racine : cp .env.example .env
# =============================================================================

# --- General ---------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# --- Base de donnees (Postgres) --------------------------------------------
# En dev local sans Docker, `pnpm services` demarre un Postgres userspace
# sur le port 55432 et ecrit cette valeur dans .env.
DATABASE_URL=postgresql://stemlab:stemlab@localhost:55432/stemlab?schema=public

# --- Redis (file ARQ) ------------------------------------------------------
REDIS_URL=redis://localhost:56379/0

# --- Stockage objet (S3 / MinIO en dev, Cloudflare R2 en prod) -------------
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=stemlab
S3_ACCESS_KEY_ID=stemlab-dev
S3_SECRET_ACCESS_KEY=stemlab-dev-secret
# force le style "path" (obligatoire pour MinIO, inutile pour R2)
S3_FORCE_PATH_STYLE=true
# base URL publique servie par le CDN devant le bucket (prod). Vide en dev.
S3_PUBLIC_URL=

# --- Auth (better-auth) ----------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-change-me-0000000000000000000000000
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Service ML ------------------------------------------------------------
ML_API_URL=http://localhost:8000
# Secret partage HMAC : signe le webhook worker -> BFF ET les appels BFF -> ML.
# openssl rand -hex 32
ML_WEBHOOK_SECRET=dev-only-change-me-hmac-secret
# URL que le worker appelle a la fin d'un job (vue depuis le conteneur worker)
ML_WEBHOOK_URL=http://localhost:3000/api/internal/jobs/callback
# Tolerance d'horloge pour la verification de signature, en secondes
ML_WEBHOOK_TOLERANCE_SECONDS=300

# --- Pipeline ML -----------------------------------------------------------
# htdemucs (4 stems) | htdemucs_6s (6 stems : + guitar, piano)
DEMUCS_MODEL=htdemucs
# cpu | cuda
TORCH_DEVICE=cpu
# bitrate Opus des stems exportes
STEM_OPUS_BITRATE=96k
# points de forme d'onde calcules par seconde
WAVEFORM_POINTS_PER_SECOND=512

# --- Quotas ----------------------------------------------------------------
FREE_PLAN_MONTHLY_TRACKS=5
MAX_UPLOAD_BYTES=104857600

# --- Observabilite (optionnel) ---------------------------------------------
SENTRY_DSN=
SENTRY_DSN_ML=
