# syntax=docker/dockerfile:1
#
# Image de l'application web.
#
# Le monorepo impose de copier les manifestes avant les sources : sans cela, la
# moindre modification d'un fichier source invaliderait le cache d'installation
# des dependances, soit plusieurs minutes a chaque build.

FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable
WORKDIR /app

# ---- deps : a partir des seuls manifestes ---------------------------------
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web/package.json apps/web/
COPY packages/contracts/package.json packages/contracts/
COPY packages/database/package.json packages/database/
COPY packages/ui/package.json packages/ui/
COPY packages/music/package.json packages/music/
COPY packages/audio-engine/package.json packages/audio-engine/
COPY packages/offline/package.json packages/offline/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

# ---- dev : sources montees en volume par docker compose -------------------
FROM deps AS dev
COPY . .
RUN pnpm --filter @stemlab/database generate
EXPOSE 3000
CMD ["pnpm", "--filter", "@stemlab/web", "dev", "--host", "0.0.0.0"]

# ---- build ----------------------------------------------------------------
FROM deps AS build
COPY . .
RUN pnpm --filter @stemlab/database generate && pnpm --filter @stemlab/web build

# ---- runtime --------------------------------------------------------------
FROM base AS runtime
ENV NODE_ENV=production PORT=3000
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web/package.json apps/web/
COPY packages/contracts/package.json packages/contracts/
COPY packages/database/package.json packages/database/
COPY packages/ui/package.json packages/ui/
COPY packages/music/package.json packages/music/
COPY packages/audio-engine/package.json packages/audio-engine/
COPY packages/offline/package.json packages/offline/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile --prod

# Le client Prisma est genere en TypeScript dans le paquet : il voyage avec les
# sources des paquets, pas dans un `node_modules` a part.
COPY packages packages
COPY --from=build /app/packages/database/src/generated packages/database/src/generated
COPY --from=build /app/apps/web/build apps/web/build

# Les migrations sont jouees par le `release_command` de Fly, pas au demarrage :
# deux instances qui migrent en meme temps se marcheraient dessus.
COPY packages/database/prisma packages/database/prisma

EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=20s \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["pnpm", "--filter", "@stemlab/web", "start"]
