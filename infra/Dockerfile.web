# syntax=docker/dockerfile:1
# ---- base : node + pnpm via corepack -------------------------------------
FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable
WORKDIR /app

# ---- deps : installe a partir des seuls manifests (cache docker) ---------
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web/package.json apps/web/
COPY packages/contracts/package.json packages/contracts/
COPY packages/audio-engine/package.json packages/audio-engine/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

# ---- dev : sources montees en volume par docker compose ------------------
FROM deps AS dev
COPY . .
RUN pnpm --filter @stemlab/web exec prisma generate
EXPOSE 3000
CMD ["pnpm", "--filter", "@stemlab/web", "dev", "--host", "0.0.0.0"]

# ---- build : bundle de production ----------------------------------------
FROM deps AS build
COPY . .
RUN pnpm --filter @stemlab/web exec prisma generate && pnpm --filter @stemlab/web build

# ---- runtime : image finale, deps de production uniquement ---------------
FROM base AS runtime
ENV NODE_ENV=production
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web/package.json apps/web/
COPY packages/contracts/package.json packages/contracts/
COPY packages/audio-engine/package.json packages/audio-engine/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile --prod
COPY --from=build /app/apps/web/build apps/web/build
COPY --from=build /app/apps/web/node_modules/.prisma apps/web/node_modules/.prisma
COPY apps/web/prisma apps/web/prisma
COPY packages packages
EXPOSE 3000
CMD ["pnpm", "--filter", "@stemlab/web", "start"]
