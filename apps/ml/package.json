{
  "name": "@stemlab/ml",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "uv run uvicorn ml.api:app --host 0.0.0.0 --port 8000 --reload",
    "build": "uv sync --frozen --no-install-project",
    "typecheck": "uv run mypy",
    "lint": "uv run ruff check . ../../scripts && uv run ruff format --check . ../../scripts",
    "test": "uv run pytest",
    "worker": "uv run arq ml.worker.WorkerSettings"
  }
}
